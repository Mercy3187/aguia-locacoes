# ═════════════════════════════════════════════
#  Águia Locações — variáveis de ambiente
#  Copie para .env (local) e cadastre as mesmas na Vercel (produção).
#  Nunca commite o .env.
# ═════════════════════════════════════════════

# ─────────────────────────────────────────────
# Banco de dados (Supabase / PostgreSQL)
# Supabase → Connect → "Transaction pooler" (porta 6543). Aguenta muito mais
# conexões que o Session pooler (5432), que estoura em serverless.
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.PROJETO:SENHA@HOST.pooler.supabase.com:6543/postgres"

# ─────────────────────────────────────────────
# Autenticação (Auth.js) — gere com: npx auth secret
# Use um segredo DIFERENTE em dev e em produção.
# ─────────────────────────────────────────────
AUTH_SECRET=""

# URL pública da aplicação (usada nos links que o motorista recebe)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# Supabase Storage (fotos do painel e da placa)
# Supabase → Project Settings → API Keys
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# ─────────────────────────────────────────────
# Asaas (cobranças / boletos)
# Vazio = integração desligada (a tela de Inadimplência avisa).
# A chave começa com "$": escreva com barra na frente, ex.: "\$aact_..."
# ASAAS_ENV="sandbox" para testes; qualquer outro valor = produção.
# ─────────────────────────────────────────────
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"

# ─────────────────────────────────────────────
# Rotina diária (/api/cron/diario, agendada no vercel.json)
# Sem este valor a rota responde 503 e não roda. Gere com: npx auth secret
# ─────────────────────────────────────────────
CRON_SECRET=""

# ─────────────────────────────────────────────
# OCR do hodômetro (ocr.space) — opcional.
# Sem chave usa a demo pública, com limite baixo. Chave grátis em
# https://ocr.space/ocrapi
# ─────────────────────────────────────────────
OCR_SPACE_API_KEY=""

# ─────────────────────────────────────────────
# Administrador inicial (npm run db:seed). Troque a senha no primeiro acesso.
# ─────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@aguialocacoes.com.br"
SEED_ADMIN_PASSWORD="admin123"

# ─────────────────────────────────────────────
# Extensão do Chrome — automação de Principal Condutor (SENATRAN) e
# importação de multas (DETRAN-PE). Opcional.
#
# NEXT_PUBLIC_SENATRAN_EXTENSION_ID não é secreto: é o ID que aparece em
# chrome://extensions depois de instalar a extensão.
# EXTENSION_API_TOKEN É SECRETO — gere com `npx auth secret`, cole aqui E no
# popup da extensão. Protege as rotas /api/extensao/*.
# ─────────────────────────────────────────────
NEXT_PUBLIC_SENATRAN_EXTENSION_ID=""
EXTENSION_API_TOKEN=""
