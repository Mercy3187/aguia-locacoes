# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca versionar segredos; só o modelo sem valores vai junto
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# configuracoes locais do Claude Code (por maquina, nao versionar)
.claude/settings.local.json

# Planilhas de relatório com dados reais de clientes — nunca versionar.
/src/RELATORIO CORRETO ATUALIZADO/

# PDFs de multa usados como modelo — documentos reais, com placa e auto de
# infração de verdade. O leitor é testado por dev-tools/testar-multas-*.mts,
# que não dependem destes arquivos.
/MODELO MULTAS/
