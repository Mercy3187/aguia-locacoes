// Schema do banco de dados — Águia Locações
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"

  // ── Por que este preview está ligado ──
  // Sem ele, uma consulta que pede relações (`include`) vira VÁRIAS consultas
  // ao banco, uma por relação, disparadas em sequência. A tela de Motoristas
  // pede quatro relações e pagava quatro idas e voltas até São Paulo só para
  // montar uma lista.
  //
  // Com `relationJoins`, o Prisma resolve tudo num SQL só, com LATERAL JOIN.
  // Medido contra este banco, a consulta da tela de Motoristas:
  //
  //     sem  relationJoins → 260ms
  //     com  relationJoins →  62ms   (4,2x)
  //
  // Antes de ligar, as 16 formas de consulta com relação que o sistema usa
  // foram rodadas nas duas estratégias e comparadas: os dados voltam
  // idênticos, byte a byte (veja `dev-tools/testar-relacoes-join.mts`).
  //
  // É recurso em preview. Para voltar atrás basta apagar esta linha e rodar
  // `npx prisma generate` — nenhuma consulta do código precisa mudar, porque
  // nenhuma pede a estratégia explicitamente.
  previewFeatures = ["relationJoins"]

  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  FINANCEIRO
  FUNCIONARIO
}

enum VehicleStatus {
  DISPONIVEL
  ALUGADO
  MANUTENCAO
  VENDIDO
  RESERVADO
}

enum OilStatus {
  VERDE
  AMARELO
  VERMELHO
}

enum ContractStatus {
  ATIVO
  ENCERRADO
  CANCELADO
  PENDENTE
}

/// Status da automação de indicação de Principal Condutor no Portal SENATRAN.
enum PrincipalCondutorAutomacaoStatus {
  ENVIADO
  ACEITO
  ERRO
}

enum PersonType {
  FISICA
  JURIDICA
}

/// Unidade do período do contrato — cada fatura cobre 1 período.
enum ContractPeriodType {
  DIAS
  SEMANAS
  QUINZENAS
  MESES
}

/// Quando a fatura do período é emitida.
enum BillingMode {
  /// No começo do período (paga antes de usar).
  ANTECIPADO
  /// No fim do período (paga depois de usar).
  POSTECIPADO
}

enum PaymentStatus {
  EM_DIA
  ATRASADO
  PENDENTE
}

enum KmRequestStatus {
  PENDENTE
  ENVIADO
  RESPONDIDO
  VENCIDO
  CANCELADO
}

enum KmRequestType {
  QUINZENAL
  MANUAL
  DEVOLUCAO
  REVISAO
}

enum ValidationStatus {
  APROVADO
  PENDENTE_CONFERENCIA
  SUSPEITO
  RECUSADO
}

enum MaintenanceStatus {
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum AdjustmentType {
  MULTA_KM
  DESCONTO_MANUTENCAO
  OUTRO
}

enum DebtType {
  MULTA_TRANSITO
  AVARIA
  COMBUSTIVEL
  FRANQUIA
  LIMPEZA
  GUINCHO
  OUTRO
}

enum DebtStatus {
  ABERTA
  COBRADA
  PAGA
  CANCELADA
}

/// De onde a multa foi importada — a regra de leitura/seletor é diferente
/// pra cada fonte, então vale saber depois de onde cada registro veio.
enum FineOrigin {
  SENATRAN
  DETRAN
  MANUAL
}

// ─────────────────────────────────────────────────────────────
// USUÁRIOS / AUTENTICAÇÃO
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(FUNCIONARIO)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sentKmRequests KmRequest[] @relation("SentBy")
  /// Contratos em que esta pessoa aparece como promotor (quem fechou a venda).
  promotedContracts Contract[] @relation("ContractPromoter")
  createdDebts   Debt[]      @relation("DebtCreatedBy")
  auditLogs      AuditLog[]  @relation("AuditActor")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// MÓDULO 2 — VEÍCULOS
// ─────────────────────────────────────────────────────────────

model Vehicle {
  id                  String        @id @default(cuid())
  plate               String        @unique
  /// Código RENAVAM — necessário pro Portal SENATRAN (URL do veículo lá usa
  /// placa + renavam). Preenchido na primeira automação de Principal
  /// Condutor que visitar o carro (o portal mostra na tela "Dados do
  /// Veículo"); depois disso fica congelado e as próximas visitas vão
  /// direto, sem precisar buscar na lista de novo.
  renavam             String?       @map("renavam")
  brand               String?
  model               String?
  year                Int?
  color               String?
  status              VehicleStatus @default(DISPONIVEL)
  ownerName           String?       @map("owner_name")
  /// CPF/CNPJ do proprietário NO DOCUMENTO do veículo — exigido pela consulta
  /// de multas do DETRAN-PE (além de placa+renavam). Não confundir com
  /// `ownerName`, que é só o nome usado nos relatórios internos.
  ownerDocument       String?       @map("owner_document")
  purchaseValue       Decimal?      @map("purchase_value") @db.Decimal(12, 2)
  investedValue       Decimal?      @map("invested_value") @db.Decimal(12, 2)
  currentKm           Int           @default(0) @map("current_km")
  lastOilChangeKm     Int?          @map("last_oil_change_km")
  oilChangeIntervalKm Int           @default(10000) @map("oil_change_interval_km")
  nextOilChangeKm     Int?          @map("next_oil_change_km")
  oilStatus           OilStatus     @default(VERDE) @map("oil_status")

  // ── Correia dentada ──
  // Diferente do óleo, aqui NÃO existe "próxima troca" nem "status" gravados no
  // banco. Os dois são calculados na hora a partir da KM atual (veja
  // `lib/correia.ts`). O óleo guarda esses valores e por isso precisa ser
  // recalculado em todo ponto que mexe na KM — se algum caminho novo esquecer,
  // o status congela e mente. Calculado na leitura, isso não tem como acontecer.
  /// KM do odômetro quando a correia foi trocada pela última vez.
  lastTimingBeltKm     Int?      @map("last_timing_belt_km")
  /// Data da troca — informativa, o controle real é por quilometragem.
  lastTimingBeltAt     DateTime? @map("last_timing_belt_at")
  /// Intervalo de troca. 50.000 km é o padrão da frota, mas dá para ajustar
  /// carro a carro (há motor que pede 40 mil e motor que aguenta 60 mil).
  timingBeltIntervalKm Int       @default(50000) @map("timing_belt_interval_km")
  timingBeltNotes      String?   @map("timing_belt_notes")
  insuranceDueDate    DateTime?     @map("insurance_due_date")
  ipvaDueDate         DateTime?     @map("ipva_due_date")
  licensingDueDate    DateTime?     @map("licensing_due_date")
  notes               String?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  /// Subgrupo opcional dentro da frota (ex.: "INVESTIDOR A") — carro continua com o
  /// `ownerName` normal, o grupo é só um recorte à parte para relatório.
  vehicleGroupId String?       @map("vehicle_group_id")
  vehicleGroup   VehicleGroup? @relation(fields: [vehicleGroupId], references: [id])

  contracts    Contract[]
  kmRequests   KmRequest[]
  kmRecords    KmRecord[]
  oilChanges   OilChange[]
  maintenances Maintenance[]
  debts        Debt[]
  settlements  WeeklySettlement[]
  fines        Fine[]

  @@index([vehicleGroupId])
  @@map("vehicles")
}

/// Subgrupo de veículos dentro da frota (ex.: "INVESTIDOR A") — um recorte à parte
/// para relatório de rendimento, independente do proprietário. Um veículo
/// pertence a no máximo um grupo por vez.
model VehicleGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Lançamento automático no último dia de cada mês do período do
  /// relatório, POR VEÍCULO do grupo — entra na coluna "Extras" do
  /// Detalhado como valor NEGATIVO (desconta do Líquido, igual manutenção e
  /// peça — pedido do usuário em 2026-10-23). Nulo = sem desconto automático.
  monthlyDeductionValue Decimal? @map("monthly_deduction_value") @db.Decimal(12, 2)
  /// Texto da linha gerada e do recap abaixo do Controle de Retiradas.
  monthlyDeductionLabel String?  @map("monthly_deduction_label")

  vehicles    Vehicle[]
  withdrawals Withdrawal[]

  @@map("vehicle_groups")
}

/// Retirada de caixa do grupo (ex.: INVESTIDOR A) — data e valor, nada além disso.
/// É um lançamento do GRUPO como um todo, não de um carro específico: entra
/// no relatório de rendimento só como bloco informativo, sem mexer no
/// Líquido de cada carro (decisão do usuário em 2026-10-23).
model Withdrawal {
  id             String   @id @default(cuid())
  vehicleGroupId String   @map("vehicle_group_id")
  date           DateTime
  value          Decimal  @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  vehicleGroup VehicleGroup @relation(fields: [vehicleGroupId], references: [id])

  @@index([vehicleGroupId])
  @@map("withdrawals")
}

// ─────────────────────────────────────────────────────────────
// MÓDULO 3 — CLIENTES
// ─────────────────────────────────────────────────────────────

model Customer {
  id            String     @id @default(cuid())
  name          String
  personType    PersonType @default(FISICA) @map("person_type")
  /// Razão social. Em pessoa física repete o nome — a tela de contrato pede
  /// os dois sempre, igual ao cadastro que a equipe já usava.
  companyName   String?    @map("company_name")
  cpfCnpj       String?    @map("cpf_cnpj")
  phone         String?
  email         String?
  address       String?
  /// Dados da CNH — usados na indicação de principal condutor.
  driverLicense         String?   @map("driver_license")
  driverLicenseState    String?   @map("driver_license_state")
  driverLicenseCategory String?   @map("driver_license_category")
  driverLicenseExpiresAt DateTime? @map("driver_license_expires_at")
  status        String     @default("ativo")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  contracts  Contract[]
  kmRequests KmRequest[]
  kmRecords  KmRecord[]
  payments   Payment[]
  debts      Debt[]
  fines      Fine[]

  @@map("customers")
}

// ─────────────────────────────────────────────────────────────
// MÓDULO 4 — CONTRATOS
// ─────────────────────────────────────────────────────────────

model Contract {
  id                String         @id @default(cuid())
  customerId        String         @map("customer_id")
  vehicleId         String         @map("vehicle_id")
  startDate         DateTime       @map("start_date")
  /// NÃO é o fim do contrato — as locações são por prazo indeterminado.
  /// É até quando as faturas já foram geradas: o contrato emite um lote
  /// (ex.: 4 semanas) e, na renovação, esta data é empurrada para frente.
  ///
  /// Passar desta data não significa contrato encerrado; significa que o
  /// faturamento não foi renovado — o que PODE ser um cliente que saiu. Quem
  /// decide é o usuário, na tela de KM (veja `lib/contratos-vigencia.ts`).
  endDate           DateTime?      @map("end_date")
  weeklyValue       Decimal?       @map("weekly_value") @db.Decimal(12, 2)
  status            ContractStatus @default(PENDENTE)
  /// Quando o usuário confirmou, na tela, que a locação continua mesmo com o
  /// faturamento parado. Segura o aviso por um ciclo de boletos — sem isso, um
  /// contrato legítimo cujo lote atrasou vira alerta permanente e some no meio
  /// do ruído.
  vigenciaConfirmadaAt DateTime? @map("vigencia_confirmada_at")

  // ── Principal condutor (DETRAN/SENATRAN) ──
  // Confirmação MANUAL de que esta pessoa foi cadastrada como principal
  // condutora deste carro no DETRAN/SENATRAN — não dá pra confirmar
  // automaticamente, é fora do sistema. Nulo = ainda não revisado (todo
  // contrato nasce assim). Fica por CONTRATO, não por pessoa: quando o
  // contrato muda (outro carro, ou o mesmo motorista renovando), a pergunta
  // volta a valer do zero. Pedido do usuário em 2026-10-23.
  principalCondutorConfirmado    Boolean?  @map("principal_condutor_confirmado")
  principalCondutorRevisadoAt    DateTime? @map("principal_condutor_revisado_at")
  principalCondutorRevisadoPorId String?   @map("principal_condutor_revisado_por_id")

  // Automação (Portal SENATRAN, via certificado digital — 2026-10-23). Além
  // da confirmação manual acima: registra o que a automação tentou/obteve.
  // ENVIADO = indicação enviada, falta o motorista aceitar no gov.br dele.
  // ACEITO = uma revisita confirmou que o motorista já aceitou (aí
  // `principalCondutorConfirmado` também vira true, automaticamente).
  // ERRO = a automação tentou e não conseguiu — ver `principalCondutorAutomacaoErro`.
  principalCondutorAutomacaoStatus PrincipalCondutorAutomacaoStatus? @map("principal_condutor_automacao_status")
  principalCondutorAutomacaoEm     DateTime?                         @map("principal_condutor_automacao_em")
  principalCondutorAutomacaoErro   String?                           @map("principal_condutor_automacao_erro")

  // ── Caução ──
  /// Valor total combinado da caução.
  depositValue      Decimal?  @map("deposit_value") @db.Decimal(12, 2)
  /// Quanto o motorista já pagou (permite caução parcelada).
  depositPaidValue  Decimal   @default(0) @map("deposit_paid_value") @db.Decimal(12, 2)
  depositPaidAt     DateTime? @map("deposit_paid_at")
  depositRefundedAt DateTime? @map("deposit_refunded_at")
  depositNotes      String?   @map("deposit_notes")

  // ── Entrega do veículo ao motorista ──
  /// Data e hora em que o motorista retira/retirou o carro.
  pickupDate        DateTime? @map("pickup_date")
  pickupDone        Boolean   @default(false) @map("pickup_done")
  pickupNotes       String?   @map("pickup_notes")

  // ── Gerar contrato (tela "Gerar Contrato") ──
  // Os campos abaixo espelham o formulário de contrato que a equipe já usava.
  periodType      ContractPeriodType @default(SEMANAS) @map("period_type")
  /// Valor de UM período (dia, semana, quinzena ou mês, conforme `periodType`).
  /// `weeklyValue` continua existindo porque o acerto semanal, o rendimento e
  /// a inadimplência leem por semana — ao gerar o contrato ele é preenchido
  /// com o equivalente semanal deste valor (veja `lib/contrato-gerar.ts`).
  periodValue     Decimal?           @map("period_value") @db.Decimal(12, 2)
  invoiceCount    Int?               @map("invoice_count")
  billingMode     BillingMode?       @map("billing_mode")
  promoterId      String?            @map("promoter_id")
  classification  String?
  billingUnit     String?            @map("billing_unit")
  hiringDelivery  String?            @map("hiring_delivery")
  additionalInfo  String?            @map("additional_info")
  priceTable      String?            @map("price_table")
  kmFranchise     String?            @map("km_franchise")

  // ── Linha do tempo do veículo ──
  // Entrega = `pickupDate` (acima). Devolução = `returnedAt`. O intervalo
  // entre os dois é o período em que o carro esteve com este cliente; a ficha
  // do veículo monta o histórico a partir daqui.
  deliveryOdometer Int?      @map("delivery_odometer")
  deliveryFuel     String?   @map("delivery_fuel")
  returnedAt       DateTime? @map("returned_at")
  returnOdometer   Int?      @map("return_odometer")
  returnFuel       String?   @map("return_fuel")
  returnNotes      String?   @map("return_notes")

  /// "Primeiro pagamento recebido?" marcado ao gerar o contrato.
  firstPaymentReceived Boolean @default(false) @map("first_payment_received")
  /// Como a caução foi recebida (PIX, dinheiro...).
  depositPaymentMethod String? @map("deposit_payment_method")

  paymentStatus     PaymentStatus  @default(PENDENTE) @map("payment_status")
  nextKmRequestDate DateTime?      @map("next_km_request_date")
  lastKmRequestDate DateTime?      @map("last_km_request_date")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  customer     Customer             @relation(fields: [customerId], references: [id])
  vehicle      Vehicle              @relation(fields: [vehicleId], references: [id])
  promoter     User?                @relation("ContractPromoter", fields: [promoterId], references: [id])
  items        ContractItem[]
  kmRequests   KmRequest[]
  kmRecords    KmRecord[]
  maintenances Maintenance[]
  adjustments  ContractAdjustment[]
  payments     Payment[]
  debts        Debt[]
  settlements  WeeklySettlement[]
  fines        Fine[]

  @@index([customerId])
  @@index([vehicleId])
  @@map("contracts")
}

/// Item adicional cobrado junto do contrato (ex.: cadeirinha, motorista extra).
model ContractItem {
  id          String    @id @default(cuid())
  contractId  String    @map("contract_id")
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  description String
  value       Decimal   @db.Decimal(12, 2)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_items")
}

// ─────────────────────────────────────────────────────────────
// MÓDULO 5 — SOLICITAÇÕES DE KM (a cada 15 dias)
// ─────────────────────────────────────────────────────────────

model KmRequest {
  id              String          @id @default(cuid())
  contractId      String          @map("contract_id")
  customerId      String          @map("customer_id")
  vehicleId       String          @map("vehicle_id")
  token           String          @unique
  expiresAt       DateTime?       @map("expires_at")
  usedAt          DateTime?       @map("used_at")
  status          KmRequestStatus @default(PENDENTE)
  requestType     KmRequestType   @default(QUINZENAL) @map("request_type")
  whatsappMessage String?         @map("whatsapp_message")
  whatsappLink    String?         @map("whatsapp_link")
  sentByUserId    String?         @map("sent_by_user_id")
  sentAt          DateTime?       @map("sent_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  contract Contract  @relation(fields: [contractId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  sentBy   User?     @relation("SentBy", fields: [sentByUserId], references: [id])
  kmRecord KmRecord?

  @@index([contractId])
  @@index([status])
  @@map("km_requests")
}

// ─────────────────────────────────────────────────────────────
// MÓDULO 8 — REGISTROS DE KM
// ─────────────────────────────────────────────────────────────

model KmRecord {
  id                 String           @id @default(cuid())
  kmRequestId        String?          @unique @map("km_request_id")
  contractId         String           @map("contract_id")
  customerId         String           @map("customer_id")
  vehicleId          String           @map("vehicle_id")
  informedKm         Int              @map("informed_km")
  ocrKm              Int?             @map("ocr_km")
  /// KM corrigida na conferência, quando o motorista digitou errado.
  /// `informedKm` continua guardando o que ele digitou — a correção não apaga
  /// o original, senão não dá para auditar depois o que foi mudado e por quê.
  correctedKm        Int?             @map("corrected_km")
  /// Quando a KM deste registro passou a valer para o veículo. Nulo = o
  /// registro ainda não foi conferido, então não mexeu na KM do carro.
  appliedAt          DateTime?        @map("applied_at")
  fuelLevel          String?          @map("fuel_level")
  dashboardPhotoUrl  String?          @map("dashboard_photo_url")
  platePhotoUrl      String?          @map("plate_photo_url")
  vehiclePhotosUrls  String[]         @map("vehicle_photos_urls")
  latitude           Float?
  longitude          Float?
  approximateAddress String?          @map("approximate_address")
  ipAddress          String?          @map("ip_address")
  validationStatus   ValidationStatus @default(PENDENTE_CONFERENCIA) @map("validation_status")
  validationNotes    String?          @map("validation_notes")
  createdAt          DateTime         @default(now()) @map("created_at")

  kmRequest KmRequest? @relation(fields: [kmRequestId], references: [id])
  contract  Contract   @relation(fields: [contractId], references: [id])
  customer  Customer   @relation(fields: [customerId], references: [id])
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([contractId])
  @@map("km_records")
}

// ─────────────────────────────────────────────────────────────
// MÓDULO 10 — TROCA DE ÓLEO
// ─────────────────────────────────────────────────────────────

model OilChange {
  id           String   @id @default(cuid())
  vehicleId    String   @map("vehicle_id")
  lastChangeKm Int      @map("last_change_km")
  intervalKm   Int      @map("interval_km")
  nextChangeKm Int      @map("next_change_km")
  oilType      String?  @map("oil_type")
  oilFilter    Boolean  @default(false) @map("oil_filter")
  airFilter    Boolean  @default(false) @map("air_filter")
  cabinFilter  Boolean  @default(false) @map("cabin_filter")
  fuelFilter   Boolean  @default(false) @map("fuel_filter")
  workshop     String?
  value        Decimal? @db.Decimal(12, 2)
  date         DateTime
  invoiceUrl   String?  @map("invoice_url")
  createdAt    DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("oil_changes")
}

// ─────────────────────────────────────────────────────────────
// MANUTENÇÕES
// ─────────────────────────────────────────────────────────────

model Maintenance {
  id               String            @id @default(cuid())
  /// Nulo = manutenção avulsa (carro fora da frota). Veja o bloco "Carro
  /// avulso" mais abaixo.
  vehicleId        String?           @map("vehicle_id")
  contractId       String?           @map("contract_id")
  type             String
  description      String?
  /// Quem faz o SERVIÇO — a oficina, o mecânico.
  workshop         String?
  /// Total gasto: `partsCost` + `laborCost`. Continua sendo o número que os
  /// relatórios, o fechamento e o ressarcimento leem, para que a separação
  /// abaixo não obrigue cada consulta a somar duas colunas (e esquecer uma).
  /// Nunca é digitado: sai da conta das duas partes.
  cost             Decimal?          @db.Decimal(12, 2)

  // ── Peça e mão de obra ──
  // A peça é comprada por fora, na autopeças, e entregue ao mecânico; ao
  // mecânico se paga só o serviço. São dois desembolsos, para dois
  // fornecedores, e antes iam somados num campo só — o que impedia saber
  // quanto da frota é peça e quanto é serviço.
  //
  // Os dois aceitam nulo porque nem sempre o valor existe no momento do
  // registro: pela tela de Motoristas o carro entra em manutenção sem custo
  // nenhum e só na saída se sabe quanto foi. Nulo = ainda não informado;
  // zero = informado e não teve (alinhamento sem peça, por exemplo).
  /// Quanto custou a peça.
  partsCost      Decimal? @map("parts_cost") @db.Decimal(12, 2)
  /// Quanto foi pago ao mecânico pelo serviço.
  laborCost      Decimal? @map("labor_cost") @db.Decimal(12, 2)
  /// Onde a peça foi comprada — a autopeças, que não é a oficina.
  partsSupplier  String?  @map("parts_supplier")
  startAt          DateTime          @map("start_at")
  endAt            DateTime?         @map("end_at")
  status           MaintenanceStatus @default(EM_ANDAMENTO)
  downtimeDiscount Decimal?          @map("downtime_discount") @db.Decimal(12, 2)

  // ── Carro avulso ──
  // Serviço em carro que não é da frota: entra e sai, não é alugado, não tem
  // KM nem óleo controlados.
  //
  // Por que os dados ficam aqui e não numa linha em `vehicles`: um veículo
  // cadastrado aparece na contagem da frota, no painel de óleo, no da correia,
  // na cobrança de KM e no fechamento. Para o avulso não vazar para essas
  // telas seria preciso excluí-lo em TODA consulta de veículo — e basta uma
  // nova consulta esquecer o filtro para a frota passar a mentir. Sem linha em
  // `vehicles`, esse esquecimento não tem como acontecer.
  //
  // `vehicleId` nulo é o que marca a manutenção como avulsa.
  /// Placa informada na hora. Texto livre: o carro não é cadastrado.
  avulsoPlate String? @map("avulso_plate")
  /// Modelo/descrição do carro avulso ("Fiat Uno 2015").
  avulsoModel String? @map("avulso_model")


  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  @@index([vehicleId])
  @@index([status])
  @@map("maintenances")
}

// ─────────────────────────────────────────────────────────────
// TRILHA DE AUDITORIA — quem fez o quê
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id String @id @default(cuid())

  userId String? @map("user_id")
  /// Cópia do nome no momento da ação: a trilha continua legível mesmo que
  /// o usuário seja renomeado ou removido depois.
  userName String  @map("user_name")
  userRole String? @map("user_role")

  /// Ação em formato "area.verbo" — ex.: "pagamento.baixa", "divida.cobranca".
  action String
  /// Tabela afetada e id do registro, para rastrear.
  entity   String
  entityId String? @map("entity_id")

  /// Frase pronta para leitura humana na tela.
  summary String
  /// Valor envolvido, quando a ação mexe em dinheiro.
  amount Decimal? @db.Decimal(12, 2)
  /// Contexto extra (antes/depois, resposta do Asaas...).
  metadata Json?

  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation("AuditActor", fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// DÍVIDAS DO MOTORISTA (multa de trânsito, avaria, combustível…)
// ─────────────────────────────────────────────────────────────

model Debt {
  id          String     @id @default(cuid())
  customerId  String     @map("customer_id")
  /// Contrato/veículo de referência — ajuda a saber de qual locação veio.
  contractId  String?    @map("contract_id")
  vehicleId   String?    @map("vehicle_id")
  type        DebtType
  description String
  /// Valor TOTAL da dívida (quando parcelada, é a soma das parcelas).
  amount      Decimal    @db.Decimal(12, 2)
  /// Em quantas vezes o motorista vai pagar. 1 = à vista.
  installments Int       @default(1)
  /// Vencimento — quando parcelada, é o da primeira parcela.
  dueDate     DateTime   @map("due_date")
  /// Data do fato (data da multa, do acidente...). Diferente do vencimento.
  occurredAt  DateTime?  @map("occurred_at")
  status      DebtStatus @default(ABERTA)
  notes       String?

  /// Cobrança gerada no Asaas para esta dívida (separada das do aluguel).
  /// Quando parcelada, é a PRIMEIRA parcela.
  asaasPaymentId String?   @unique @map("asaas_payment_id")
  /// Id do carnê no Asaas, quando a dívida é parcelada.
  asaasInstallmentId String? @map("asaas_installment_id")
  invoiceUrl     String?   @map("invoice_url")
  bankSlipUrl    String?   @map("bank_slip_url")
  paidAt         DateTime? @map("paid_at")
  lastChargedAt  DateTime? @map("last_charged_at")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer  Customer  @relation(fields: [customerId], references: [id])
  contract  Contract? @relation(fields: [contractId], references: [id])
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id])
  createdBy User?     @relation("DebtCreatedBy", fields: [createdById], references: [id])
  /// Multa de origem, quando esta dívida foi lançada a partir de uma
  /// (`Fine.debtId`) — nulo pra dívidas de outro tipo ou lançadas antes
  /// dessa automação existir.
  fine      Fine?

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("debts")
}

// ─────────────────────────────────────────────────────────────
// MULTAS DE TRÂNSITO — importadas automaticamente do SENATRAN/DETRAN
// ─────────────────────────────────────────────────────────────
//
// Esta tabela é só o CATÁLOGO do que foi lido nos portais oficiais — de
// quem é o carro, de quem é a responsabilidade (cruzado com o histórico de
// contratos) e se a PRÓPRIA EMPRESA já pagou a multa ao órgão de trânsito.
//
// Cobrar o motorista é outra coisa, que o sistema já sabe fazer: quando o
// operador decide cobrar, cria-se uma `Debt` normal (tipo MULTA_TRANSITO,
// com cobrança no Asaas e tudo) e `debtId` aponta pra ela — evita que a
// mesma multa vire duas dívidas, e evita reinventar status de pagamento que
// a `Debt` já resolve bem.

model Fine {
  id           String     @id @default(cuid())
  /// Número do Auto de Infração — identifica a multa de forma única entre
  /// consultas repetidas (a mesma automação roda todo dia; sem isso,
  /// importaria a mesma multa de novo a cada rodada).
  ticketNumber String     @unique @map("ticket_number")
  vehicleId    String     @map("vehicle_id")
  /// Placa no momento da importação — cache de exibição; a fonte de verdade
  /// é o veículo (`vehicleId`).
  plate        String
  occurredAt   DateTime   @map("occurred_at")
  description  String
  amount       Decimal    @db.Decimal(12, 2)
  origin       FineOrigin

  // ── De quem é a responsabilidade ──
  // Mesma regra de `acharResponsavel()` (lib/multas-responsavel.ts), já
  // calculada e guardada na importação — não precisa recalcular pra exibir.
  contractId      String? @map("contract_id")
  customerId      String? @map("customer_id")
  /// Explicação quando NÃO há responsável único: ambíguo (dois contratos no
  /// período), sem contrato na data, data fora do histórico que o sistema
  /// conhece, etc.
  responsibleNote String? @map("responsible_note")

  // ── Pagamento À AUTORIDADE (SENATRAN/DETRAN) ──
  // Separado de cobrar o motorista: é a empresa quitando a multa em si
  // junto ao órgão de trânsito (às vezes com desconto por pagamento
  // antecipado, daí o valor poder ser diferente do `amount` original).
  /// Nulo = a empresa ainda não pagou a multa ao órgão de trânsito.
  paidToAuthorityAt     DateTime? @map("paid_to_authority_at")
  paidToAuthorityAmount Decimal?  @map("paid_to_authority_amount") @db.Decimal(12, 2)

  // ── Cobrança do motorista ──
  /// Dívida criada pra cobrar o motorista por esta multa — ver comentário do
  /// bloco acima. Nula = ainda não decidiram cobrar (ou decidiram não cobrar).
  debtId String? @unique @map("debt_id")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  debt     Debt?     @relation(fields: [debtId], references: [id])

  @@index([vehicleId])
  @@index([contractId])
  @@index([customerId])
  @@index([occurredAt])
  @@map("fines")
}

// ─────────────────────────────────────────────────────────────
// COBRANÇAS DO ASAAS (espelho do que está no Asaas)
// ─────────────────────────────────────────────────────────────

model Payment {
  id           String    @id @default(cuid())
  asaasId      String    @unique @map("asaas_id")
  contractId   String?   @map("contract_id")
  customerId   String?   @map("customer_id")
  plate        String?
  value        Decimal   @db.Decimal(12, 2)
  netValue     Decimal?  @map("net_value") @db.Decimal(12, 2)
  /// Status espelhado do Asaas: PENDING, RECEIVED, OVERDUE, CONFIRMED...
  status       String
  billingType  String?   @map("billing_type")
  dueDate      DateTime  @map("due_date")
  paymentDate  DateTime? @map("payment_date")
  description  String?
  invoiceUrl   String?   @map("invoice_url")
  bankSlipUrl  String?   @map("bank_slip_url")
  /// Baixa manual feita aqui (ex.: motorista pagou em dinheiro).
  settledLocally Boolean  @default(false) @map("settled_locally")
  settledAt      DateTime? @map("settled_at")
  settledNote    String?   @map("settled_note")
  /// Última vez que a cobrança foi enviada ao motorista pelo WhatsApp.
  lastChargedAt DateTime? @map("last_charged_at")
  syncedAt      DateTime  @default(now()) @map("synced_at")

  contract Contract? @relation(fields: [contractId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([contractId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// AJUSTES DE COBRANÇA (multas e descontos aplicados à semana seguinte)
// ─────────────────────────────────────────────────────────────

model ContractAdjustment {
  id          String         @id @default(cuid())
  contractId  String         @map("contract_id")
  type        AdjustmentType
  amount      Decimal        @db.Decimal(12, 2) // positivo = cobra a mais; negativo = desconto
  description String?
  referenceId String?        @map("reference_id")
  settled     Boolean        @default(false)
  createdAt   DateTime       @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@map("contract_adjustments")
}

// ─────────────────────────────────────────────────────────────
// ACERTO SEMANAL (quem pagou a semana, carro a carro)
// ─────────────────────────────────────────────────────────────

/// Um registro por carro por semana: a marcação de "pagou" que alimenta o
/// relatório de segunda-feira.
///
/// A linha só nasce quando alguém mexe nela na tela. Carro sem registro na
/// semana conta como pendente — assim abrir a tela não grava nada, e semana
/// que ninguém acertou não deixa lixo no banco.
model WeeklySettlement {
  id         String    @id @default(cuid())
  /// Segunda-feira da semana do acerto. É data de calendário, não instante:
  /// guardada como `date` ela não escorrega para o domingo em outro fuso.
  weekStart  DateTime  @map("week_start") @db.Date
  vehicleId  String    @map("vehicle_id")
  contractId String?   @map("contract_id")
  /// Nome do motorista no dia do acerto. Fica congelado de propósito: se o
  /// carro trocar de mão depois, o relatório da semana passada continua
  /// mostrando quem de fato pagou.
  driverName String?   @map("driver_name")
  value      Decimal   @db.Decimal(12, 2)
  paid       Boolean   @default(false)
  paidAt     DateTime? @map("paid_at")
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  @@unique([weekStart, vehicleId])
  @@index([weekStart])
  @@map("weekly_settlements")
}
